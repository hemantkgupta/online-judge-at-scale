# Copy this file to `terraform.tfvars` (which is gitignored) and override
# whatever you need. Defaults from variables.tf match the multi-region setup:
# asia-south1 + us-central1, n2-standard-2 SPOT (both VMs), nested-virt
# enabled, 25 GB disks, auto-shutdown at 23:00 IST.

project_id          = "online-judge-hk"
primary_region      = "asia-south1"
primary_zone        = "asia-south1-a"
secondary_region    = "us-central1"
secondary_zone      = "us-central1-a"
ssh_user            = "hemant"
ssh_public_key_path = "~/.ssh/id_rsa.pub"

# Cost-knob overrides (uncomment to change defaults)
# region_use_spot     = false              # turn off if preemption is annoying
# region_machine_type = "n2-standard-4"    # bigger box on both VMs
# disk_size_gb        = 50                 # larger boot disk

# auto_shutdown_cron     = "0 22 * * *"    # 10 PM IST instead of 11 PM
# auto_shutdown_timezone = "Asia/Kolkata"

# Sandbox backend selection (applied to BOTH VMs)
# sandbox_backend         = "docker"
# sandbox_docker_runtime  = "runsc"
# linux_hardening_enabled = true
